<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Safeish Insurance</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        .navbar-brand { font-weight: 800; letter-spacing: -0.5px; font-size: 1.5rem; }
        .nav-link { font-weight: 600; font-size: 0.95rem; }
    </style>
</head>
<body class="d-flex flex-column min-vh-100">
    <header>
        <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom py-3">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center text-primary" asp-area="" asp-controller="Home" asp-action="Index">
                    <div class="bg-primary text-white rounded d-flex align-items-center justify-content-center me-2 fs-5" style="width: 36px; height: 36px; line-height: 1;">SI</div>
                    Safeish Insurance
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-lg-flex justify-content-between align-items-center">
                    <ul class="navbar-nav mx-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link px-3 active-link" href="/#hero">Ana Sayfa</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link px-3" href="/#sigortalar">Sigortalar</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link px-3" href="/#anlasmali-kurumlar">Anlaşmalı Kurumlar</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link px-3" href="/#finansal-danismanlik">Finansal Danışmanlık</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link px-3" href="/#iletisim">İletişim</a>
                        </li>
                    </ul>
                    <ul class="navbar-nav">
                        @if (User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle px-3 text-dark fw-bold" href="#" id="navbarDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-person-circle me-1 text-primary"></i> @User.Identity.Name
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end shadow border-0 mt-2" aria-labelledby="navbarDropdown">
                                    <li><a class="dropdown-item py-2 transition-hover" href="/Account/Profile" target="_blank"><i class="bi bi-gear me-2 text-primary"></i>Hesap Ayarları</a></li>
                                    <li><a class="dropdown-item py-2 transition-hover" href="/Account/Profile#list-insurances" target="_blank"><i class="bi bi-shield-check me-2 text-primary"></i>Sigortalarım</a></li>
                                    <li><hr class="dropdown-divider opacity-25"></li>
                                    <li><a class="dropdown-item py-2 text-danger transition-hover fw-bold" asp-area="" asp-controller="Account" asp-action="Logout"><i class="bi bi-box-arrow-right me-2"></i>Çıkış Yap</a></li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item me-2 mb-2 mb-lg-0">
                                <a class="btn btn-outline-primary rounded-pill px-4 fw-bold" asp-area="" asp-controller="Account" asp-action="Login">Giriş Yap</a>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-primary rounded-pill px-4 fw-bold" asp-area="" asp-controller="Account" asp-action="Register">Kayıt Ol</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="flex-grow-1">
        <main role="main" class="pb-0">
            @RenderBody()
        </main>
    </div>

    <button type="button" class="btn btn-primary rounded-circle shadow d-flex align-items-center justify-content-center" id="btn-back-to-top" style="position: fixed; bottom: 30px; right: 30px; display: none; z-index: 1000; width: 50px; height: 50px; transition: opacity 0.3s;">
        <i class="bi bi-arrow-up fs-4"></i>
    </button>

    <footer class="footer bg-white py-4 border-top">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-md-6 text-center text-md-start mb-3 mb-md-0">
                    <h5 class="text-primary fw-bold mb-1">Safeish Insurance</h5>
                    <p class="text-muted small mb-0">&copy; 2024 Safeish Insurance. Koruyucu Berraklık ile Güvendesiniz.</p>
                </div>
                <div class="col-md-6 text-center text-md-end">
                    <a href="#" class="footer-link me-3">Gizlilik Politikası</a>
                    <a href="#" class="footer-link me-3">Kullanım Koşulları</a>
                    <a href="#" class="footer-link me-3">KVKK</a>
                    <a href="#" class="footer-link me-3">Çerez Politikası</a>
                    <a href="#" class="footer-link">İletişim</a>
                </div>
            </div>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    
    <script>
        let mybutton = document.getElementById("btn-back-to-top");
        window.onscroll = function () {
            if (document.body.scrollTop > 300 || document.documentElement.scrollTop > 300) {
                mybutton.style.display = "flex";
                mybutton.style.opacity = "1";
            } else {
                mybutton.style.opacity = "0";
                setTimeout(() => {
                    if(document.body.scrollTop <= 300 && document.documentElement.scrollTop <= 300) {
                        mybutton.style.display = "none";
                    }
                }, 300);
            }
        };

        mybutton.addEventListener("click", function() {
            window.scrollTo({ top: 0, behavior: 'smooth' });
        });

        // Simple active link updater for demo
        document.querySelectorAll('.navbar-nav .nav-link').forEach(link => {
            link.addEventListener('click', function() {
                document.querySelectorAll('.navbar-nav .nav-link').forEach(l => l.classList.remove('active-link'));
                this.classList.add('active-link');
            });
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
