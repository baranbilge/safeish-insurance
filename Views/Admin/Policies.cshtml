@model IEnumerable<Safeish.Models.UserPolicy>

@{
    ViewData["Title"] = "Müşteri Teklif İstekleri";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold mb-0">Müşteri Teklif İstekleri</h2>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">ID</th>
                        <th>Müşteri</th>
                        <th>Paket Adı</th>
                        <th>Durum</th>
                        <th>Oluşturulma Tarihi</th>
                        <th class="text-end pe-4">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-4">@item.Id</td>
                            <td class="fw-bold">
                                @item.User?.FirstName @item.User?.LastName
                                <br/>
                                <small class="text-muted fw-normal">@item.User?.Email</small>
                            </td>
                            <td>
                                @item.PackageName
                            </td>
                            <td>
                                @if (item.Status == "Görüşme bekleniyor")
                                {
                                    <span class="badge bg-warning text-dark">@item.Status</span>
                                }
                                else if (item.Status == "İptal Edildi")
                                {
                                    <span class="badge bg-danger">@item.Status</span>
                                }
                                else
                                {
                                    <span class="badge bg-success">@item.Status</span>
                                }
                            </td>
                            <td>@item.StartDate.ToString("dd.MM.yyyy HH:mm")</td>
                            <td class="text-end pe-4">
                                <button type="button" class="btn btn-sm btn-success me-1" data-bs-toggle="modal" data-bs-target="#approveModal-@item.Id" title="Onayla">
                                    <i class="bi bi-check-lg"></i>
                                </button>
                                <button type="button" class="btn btn-sm btn-danger" data-bs-toggle="modal" data-bs-target="#rejectModal-@item.Id" title="Reddet">
                                    <i class="bi bi-x-lg"></i>
                                </button>

                                <!-- Onay Modal -->
                                <div class="modal fade" id="approveModal-@item.Id" tabindex="-1" aria-labelledby="approveModalLabel-@item.Id" aria-hidden="true">
                                    <div class="modal-dialog modal-dialog-centered text-start">
                                        <div class="modal-content border-0 shadow rounded-4">
                                            <div class="modal-header border-0 bg-success text-white rounded-top-4">
                                                <h5 class="modal-title" id="approveModalLabel-@item.Id"><i class="bi bi-check-circle-fill me-2"></i>Talebi Onayla</h5>
                                                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                                            </div>
                                            <div class="modal-body p-4 text-center">
                                                <i class="bi bi-check-circle text-success mb-3 d-block" style="font-size: 3rem;"></i>
                                                <p class="fs-5 mb-0">Bu teklif talebini onaylamak istediğinize emin misiniz?</p>
                                                <p class="text-muted small mt-2">Kullanıcının poliçesi 2028 yılına kadar aktif edilecektir.</p>
                                            </div>
                                            <div class="modal-footer border-0 d-flex justify-content-center pb-4">
                                                <button type="button" class="btn btn-light rounded-pill px-4 fw-bold" data-bs-dismiss="modal">Vazgeç</button>
                                                <form asp-action="ApprovePolicy" asp-route-id="@item.Id" method="post">
                                                    <button type="submit" class="btn btn-success rounded-pill px-4 fw-bold">Evet, Onayla</button>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Ret Modal -->
                                <div class="modal fade" id="rejectModal-@item.Id" tabindex="-1" aria-labelledby="rejectModalLabel-@item.Id" aria-hidden="true">
                                    <div class="modal-dialog modal-dialog-centered text-start">
                                        <div class="modal-content border-0 shadow rounded-4">
                                            <div class="modal-header border-0 bg-danger text-white rounded-top-4">
                                                <h5 class="modal-title" id="rejectModalLabel-@item.Id"><i class="bi bi-x-circle-fill me-2"></i>Talebi Reddet</h5>
                                                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                                            </div>
                                            <div class="modal-body p-4 text-center">
                                                <i class="bi bi-x-circle text-danger mb-3 d-block" style="font-size: 3rem;"></i>
                                                <p class="fs-5 mb-0">Bu teklif talebini reddetmek istediğinize emin misiniz?</p>
                                            </div>
                                            <div class="modal-footer border-0 d-flex justify-content-center pb-4">
                                                <button type="button" class="btn btn-light rounded-pill px-4 fw-bold" data-bs-dismiss="modal">Vazgeç</button>
                                                <form asp-action="RejectPolicy" asp-route-id="@item.Id" method="post">
                                                    <button type="submit" class="btn btn-danger rounded-pill px-4 fw-bold">Evet, Reddet</button>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
