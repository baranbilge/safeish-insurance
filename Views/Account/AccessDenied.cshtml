@{
    ViewData["Title"] = "Erişim Engellendi";
}

<div class="container mt-5 pt-5 text-center">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="mb-4">
                <i class="bi bi-shield-lock text-danger" style="font-size: 5rem;"></i>
            </div>
            <h1 class="display-4 fw-bold">Erişim Engellendi</h1>
            <p class="lead text-muted mt-3">Bu sayfayı görüntülemek için gerekli yetkilere sahip değilsiniz.</p>
            <hr class="my-4">
            <p>Eğer bir sistem yöneticisi iseniz ve bir hata olduğunu düşünüyorsanız, lütfen tekrar giriş yapmayı deneyin.</p>
            
            <div class="mt-4">
                <a href="~/" class="btn btn-outline-danger me-2">
                    <i class="bi bi-house-door"></i> Ana Sayfaya Dön
                </a>
                <a href="~/Account/Login" class="btn btn-danger">
                    <i class="bi bi-box-arrow-in-right"></i> Farklı Bir Hesapla Giriş Yap
                </a>
            </div>
        </div>
    </div>
</div>
